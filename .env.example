# Copy to .env and adjust. The Makefile and `go run` load it automatically.
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon?sslmode=disable
PORT=8080
BEACON_ENV=development
SHUTDOWN_TIMEOUT=15s
CORS_ORIGINS=http://localhost:3000

# Auth (Ch 15–17). JWT_SECRET is required in production; in development a known
# insecure default is used if it is unset. JWT_TTL is the access-token lifetime.
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_TTL=1h

# Storage (Ch 22). S3-compatible object storage for attachments. All OPTIONAL:
# leave S3_BUCKET empty and the attachment endpoints return 501 cleanly. The
# values below target the MinIO service in docker-compose; for real AWS S3 leave
# S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false.
# S3_BUCKET=beacon
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_PRESIGN_TTL=10m

# Email (Ch 23). OPTIONAL: leave SMTP_HOST empty and emails are logged, not sent
# (the LogSender). The values below target the Mailpit service in docker-compose.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=beacon@localhost

# Worker (Ch 26). The in-process background worker polls the jobs table.
WORKER_POLL_INTERVAL=1s
WORKER_CONCURRENCY=5

# Tests (Ch 39–40). The integration and e2e tests are ENV-GATED: they connect to
# this database, migrate it, and truncate between tests. Leave it UNSET and those
# tests SKIP cleanly (so `make test` runs only the unit tests). Point it at a
# THROWAWAY database — the suite truncates every data table. CI sets it to a
# postgres:16 service container automatically.
# TEST_DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon_test?sslmode=disable

# Cache (Ch 28). OPTIONAL: leave REDIS_URL empty and the read-through cache
# still works, just per-process (in-memory LRU only). The value below targets
# the redis service in docker-compose. CACHE_TTL bounds staleness everywhere.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=60s

# Rate limiting (Ch 19). Authenticated traffic is bucketed per org; the auth
# endpoints per IP. RPS is the sustained refill rate, BURST the one-off spike.
TENANT_RATE_LIMIT_RPS=10
TENANT_RATE_LIMIT_BURST=60
AUTH_RATE_LIMIT_RPS=0.0833
AUTH_RATE_LIMIT_BURST=10

# Search (Ch 29–30). Postgres full-text search is always on and needs no config.
# Set MEILI_URL to put Meilisearch in front of it (typo tolerance, highlighting);
# leave it empty and every search runs on the Chapter 29 Postgres path.
MEILI_URL=http://localhost:7700
MEILI_KEY=beacon-dev-master-key
MEILI_INDEX=beacon

# Observability (Ch 35, 36, 50). METRICS_PORT is a SEPARATE internal listener
# carrying /metrics and /debug/pprof — never point a load balancer at it.
# ADMIN_TOKEN gates pprof for non-loopback callers. Leave
# OTEL_EXPORTER_OTLP_ENDPOINT empty and tracing is off entirely; the sample
# ratio is 0.1 in production and 1.0 locally so every request is traceable.
METRICS_PORT=9090
ADMIN_TOKEN=dev-admin-token
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACE_SAMPLE_RATIO=1.0
BEACON_VERSION=dev
