{
  "components": {
    "schemas": {
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "rule",
          "message"
        ],
        "type": "object"
      },
      "HumaError": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "LoginOutputBody": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "description": "A bearer JWT. There is no refresh endpoint.",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "token",
          "user"
        ],
        "type": "object"
      },
      "PrefsResponse": {
        "additionalProperties": false,
        "properties": {
          "example_price": {
            "type": "string"
          },
          "greeting": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "now_local": {
            "type": "string"
          },
          "now_utc": {
            "format": "date-time",
            "type": "string"
          },
          "resolved_locale": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "locale",
          "timezone",
          "resolved_locale",
          "now_utc",
          "now_local",
          "greeting",
          "example_price"
        ],
        "type": "object"
      },
      "SetPreferencesInputBody": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "maxLength": 35,
            "type": "string"
          },
          "timezone": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "locale",
          "timezone"
        ],
        "type": "object"
      },
      "SignupInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "minLength": 12,
            "type": "string"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "created_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "The token from POST /v1/auth/login. There is no refresh endpoint; when it expires, sign in again.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "A multi-tenant task board. This document is emitted from the Go handlers; it is never edited by hand.",
    "title": "Beacon API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumaError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Exchange credentials for a token",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/signup": {
      "post": {
        "description": "Returns the user. It does not return a token — call login next.",
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumaError"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create an account",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumaError"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "The authenticated user",
        "tags": [
          "me"
        ]
      }
    },
    "/v1/me/preferences": {
      "get": {
        "operationId": "get-preferences",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrefsResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumaError"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Locale and timezone, and what the cascade resolved for this request",
        "tags": [
          "me"
        ]
      },
      "patch": {
        "operationId": "set-preferences",
        "parameters": [
          {
            "description": "Repeating a request with the same key replays the original response instead of performing the write twice.",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "description": "Repeating a request with the same key replays the original response instead of performing the write twice.",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetPreferencesInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrefsResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumaError"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Set locale and timezone",
        "tags": [
          "me"
        ]
      }
    }
  }
}
