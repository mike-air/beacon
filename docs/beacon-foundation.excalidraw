      "roundness": null,
      "seed": 1391386419,
      "version": 1,
      "versionNonce": 892085629,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "6.  ERRORS CHANGE SHAPE GOING UP",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6.  ERRORS CHANGE SHAPE GOING UP",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "icupl98kwdyih268",
      "x": 974,
      "y": 936,
      "width": 283.8,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1584263353,
      "version": 1,
      "versionNonce": 687419886,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "pgx.ErrNoRows \u2192 tasks.ErrNotFound \u2192 404.\nThe driver error dies at the Repo. The HTTP\nlayer never learns what database you use.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pgx.ErrNoRows \u2192 tasks.ErrNotFound \u2192 404.\nThe driver error dies at the Repo. The HTTP\nlayer never learns what database you use.",
      "lineHeight": 1.25
    },
    {
