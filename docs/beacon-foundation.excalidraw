      "updated": 1,
      "link": null,
      "locked": false,
      "text": "minLength/required/enum generate request\nvalidation, openapi.json, and the TypeScript\nSDK from ONE declaration. Change the Go\nstruct and the web app stops compiling.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "minLength/required/enum generate request\nvalidation, openapi.json, and the TypeScript\nSDK from ONE declaration. Change the Go\nstruct and the web app stops compiling.",
