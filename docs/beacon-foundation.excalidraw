      "text": "KEY CONCEPTS \u2014 LAYER 1",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KEY CONCEPTS \u2014 LAYER 1",
