      "versionNonce": 1532729980,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "5.  EACH LAYER KNOWS ONE THING",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5.  EACH LAYER KNOWS ONE THING",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "b9ejg078jqzobdul",
      "x": 974,
      "y": 810,
      "width": 283.8,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 76948398,
      "version": 1,
      "versionNonce": 1718345172,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "sqlc knows SQL. Repo knows types and ids.\nService knows rules. Handler knows HTTP.\nAsk \"would this still be true over gRPC?\" \u2014\nif yes it belongs below the handler.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sqlc knows SQL. Repo knows types and ids.\nService knows rules. Handler knows HTTP.\nAsk \"would this still be true over gRPC?\" \u2014\nif yes it belongs below the handler.",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "evfmzdnaj3xbwibz",
      "x": 974,
      "y": 912,
      "width": 246.40000000000003,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#4263eb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
