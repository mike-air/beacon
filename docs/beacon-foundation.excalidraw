    },
    {
      "type": "text",
      "id": "lv94jjmt4kiv516s",
      "x": 974,
      "y": 196,
      "width": 215.60000000000002,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
