      "updated": 1,
      "link": null,
      "locked": false,
      "text": "3.  MIGRATIONS RUN BEFORE THE SERVER",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.  MIGRATIONS RUN BEFORE THE SERVER",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "5afzjj8kb1f25uxt",
      "x": 974,
      "y": 472,
