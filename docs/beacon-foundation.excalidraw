      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Everything the app needs to know about its\nenvironment is read once, typed once,\nvalidated once. Nothing else touches env\nvars directly.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Everything the app needs to know about its\nenvironment is read once, typed once,\nvalidated once. Nothing else touches env\nvars directly.",
      "lineHeight": 1.25
    },
    {
