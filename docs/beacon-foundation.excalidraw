      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "By the time your handler's first line runs,\nthe caller is authenticated, rate-limited,\nand proven to be a member of this org.\nThe handler can assume all of it.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "By the time your handler's first line runs,\nthe caller is authenticated, rate-limited,\nand proven to be a member of this org.\nThe handler can assume all of it.",
      "lineHeight": 1.25
    },
    {
