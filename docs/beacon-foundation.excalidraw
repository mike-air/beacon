      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8.  GATES RUN BEFORE THE HANDLER",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "cki6vx5ej2s74itd",
      "x": 974,
      "y": 1173,
      "width": 283.8,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
