      "versionNonce": 365193559,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1.  CREATE TABLE IF NOT EXISTS schema_migrations\n2.  for each file: already applied? \u2192 skip\n3.  if new: run SQL + record it \u2014 ONE transaction PER FILE",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.  CREATE TABLE IF NOT EXISTS schema_migrations\n2.  for each file: already applied? \u2192 skip\n3.  if new: run SQL + record it \u2014 ONE transaction PER FILE",
      "lineHeight": 1.25
    },
