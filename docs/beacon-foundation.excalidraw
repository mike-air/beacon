      "versionNonce": 1663052924,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1.  CONFIG IS THE GATEKEEPER",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.  CONFIG IS THE GATEKEEPER",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "an2dm1run3beydsz",
      "x": 974,
      "y": 220,
      "width": 277.20000000000005,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 727525111,
      "version": 1,
      "versionNonce": 1354086312,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Everything the app needs to know about its\nenvironment is read once, typed once,\nvalidated once. Nothing else touches env\nvars directly.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Everything the app needs to know about its\nenvironment is read once, typed once,\nvalidated once. Nothing else touches env\nvars directly.",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "0nae07olc1wgvpi4",
      "x": 974,
      "y": 322,
      "width": 161.70000000000002,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2045922636,
      "version": 1,
      "versionNonce": 1847406001,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2.  POOL \u2260 CONNECTION",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2.  POOL \u2260 CONNECTION",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "sxgffzrq016dy39m",
      "x": 974,
      "y": 346,
      "width": 283.8,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1706448402,
      "version": 1,
      "versionNonce": 1829416465,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The pool manages many reusable connections.\nRequests borrow one, use it, return it.\nOne connection per request collapses\nunder load.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The pool manages many reusable connections.\nRequests borrow one, use it, return it.\nOne connection per request collapses\nunder load.",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "8polsfcv7cpva5tk",
      "x": 974,
      "y": 448,
      "width": 277.20000000000005,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 212154787,
      "version": 1,
      "versionNonce": 2054502938,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "3.  MIGRATIONS RUN BEFORE THE SERVER",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.  MIGRATIONS RUN BEFORE THE SERVER",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "uanff4kpd4ik9789",
      "x": 974,
      "y": 472,
      "width": 297.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1577015637,
      "version": 1,
      "versionNonce": 1555067837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Guarantees the schema is correct before any\nhandler queries it. Skip this and you get\nqueries against columns that don't exist yet.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Guarantees the schema is correct before any\nhandler queries it. Skip this and you get\nqueries against columns that don't exist yet.",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "qwbj3fx2alzofn5c",
      "x": 974,
      "y": 559,
      "width": 246.40000000000003,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 911477835,
      "version": 1,
      "versionNonce": 970185011,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "4.  MIGRATIONS SERVE TWO MASTERS",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4.  MIGRATIONS SERVE TWO MASTERS",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "x6ssjy4e359qucaw",
      "x": 974,
      "y": 583,
      "width": 290.40000000000003,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1338155842,
      "version": 1,
      "versionNonce": 865620563,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Applied to the DB at runtime, AND read by\nsqlc at build time to validate your queries.\nTwo uses, one source of truth.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Applied to the DB at runtime, AND read by\nsqlc at build time to validate your queries.\nTwo uses, one source of truth.",
      "lineHeight": 1.25
    },
