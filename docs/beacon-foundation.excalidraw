      "locked": false,
      "text": "2.  POOL \u2260 CONNECTION",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2.  POOL \u2260 CONNECTION",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "bfeb2m1co3gm089x",
      "x": 974,
      "y": 346,
      "width": 283.8,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 177158231,
      "version": 1,
      "versionNonce": 1123969457,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The pool manages many reusable connections.\nRequests borrow one, use it, return it.\nOne connection per request collapses\nunder load.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The pool manages many reusable connections.\nRequests borrow one, use it, return it.\nOne connection per request collapses\nunder load.",
      "lineHeight": 1.25
    },
    {
      "type": "text",
